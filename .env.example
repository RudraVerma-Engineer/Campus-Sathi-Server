# ── Server ─────────────────────────────
PORT=5000
NODE_ENV=development
# comma separated web origins (mobile apps need nothing here)
CORS_ORIGINS=

# ── Database ───────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/campus-sathi

# ── Auth ───────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# used only by `npm run seed:admin`
SUPERADMIN_EMAIL=superadmin@campussathi.com
SUPERADMIN_PASSWORD=
# QR attendance validity in seconds
QR_EXPIRY_SECONDS=120
CAMPUS_TIMEZONE=Asia/Kolkata

# ── Cloudinary (profile photos, notice/event files) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (OTP, sent via Gmail SMTP with an app password) ──
EMAIL_USER=
EMAIL_PASS=

# ── Google sign-in (OAuth client IDs from Google Cloud Console) ──
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
